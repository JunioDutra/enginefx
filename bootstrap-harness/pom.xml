<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>enginefx</groupId>
  <artifactId>enginefx-native-bootstrap-harness</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.plugin.version>3.14.1</maven.compiler.plugin.version>
    <native.build.tools.version>1.1.12</native.build.tools.version>
    <enginefx.version>3.0.0</enginefx.version>
  </properties>
  <dependencies>
    <dependency>
      <groupId>enginefx</groupId>
      <artifactId>enginefx</artifactId>
      <version>${enginefx.version}</version>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory><targetPath>res</targetPath></resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration><release>${maven.compiler.release}</release></configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration><archive><manifest><mainClass>br.com.engine.bootstrap.NativeBootstrapHarness</mainClass></manifest></archive></configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
            <version>${native.build.tools.version}</version>
            <configuration>
              <mainClass>br.com.engine.bootstrap.NativeBootstrapHarness</mainClass>
              <imageName>enginefx-native-bootstrap-harness</imageName>
              <metadataRepository><enabled>false</enabled></metadataRepository>
              <buildArgs><buildArg>--enable-native-access=ALL-UNNAMED</buildArg></buildArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
